# SERVER ONLY. Never prefix these names with VITE_. No real credentials in this template.
LEADS_ENABLED=false
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Optional PEM CA certificate for hosted PostgreSQL. Remote TLS verifies certificates.
DATABASE_CA_CERT=
# Two DIFFERENT random 32-byte hex secrets. Generate offline: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEADS_ENCRYPTION_KEY=
LEADS_HASH_KEY=
# JSON array: [{"id":"reviewer-01","role":"reviewer","tokenHash":"<SHA256_OF_RANDOM_TOKEN>"}]
# Separate agent and human reviewer identities. Keep plaintext Bearer tokens outside the frontend/repo.
LEADS_SERVICE_ACCOUNTS=[]
# Set only after the controller approves the retention period. Schedule the retention command separately.
LEADS_RETENTION_DAYS=
# Only configure for a reverse proxy that STRIPS and OVERWRITES this header. Vercel uses its own header automatically.
LEADS_TRUSTED_IP_HEADER=
# Dedicated disposable PostgreSQL for integration tests. Never production; tests create/drop an isolated schema.
TEST_DATABASE_URL=
