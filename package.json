{
  "name": "zury-corretora-lovable",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "prepreview": "node scripts/workerd-runtime.mjs",
    "preview": "wrangler dev --config .output/server/wrangler.json --local --compatibility-date 2026-10-19",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/*.test.mjs src/components/shield/geometry.test.mjs tests/leads/*.test.mjs",
    "test:watch": "node --test --watch src/lib/*.test.mjs src/components/shield/geometry.test.mjs",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/leads-migrate.mjs",
    "db:retention": "node --env-file-if-exists=.env scripts/leads-retention.mjs",
    "test:leads": "node --test tests/leads/*.test.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "gsap": "^3.15.0",
    "lucide-react": "^0.575.0",
    "pg": "8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.186.1",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.26.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.16.5",
    "@types/pg": "8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "8.1.5",
    "wrangler": "4.151.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
